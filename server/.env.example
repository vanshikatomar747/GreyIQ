PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/greyiq
JWT_SECRET=your_secure_jwt_secret_key_here
NODE_ENV=production

# Comma-separated list of origins allowed by CORS.
# E.g. https://yourcustomdomain.com,https://www.yourcustomdomain.com
# Set to '*' to allow all origins.
ALLOWED_ORIGINS=https://greyiqsolutions.com

# Initial Admin configuration (auto-created on first run)
ADMIN_EMAIL=admin@greyiqsolutions.com
ADMIN_PASSWORD=admin_secure_password_here
ADMIN_NAME=GreyIQ Admin

# SMTP Mail Server Configuration (Optional - falls back to console logging if empty)
# Used to send email notifications when users submit support contact messages
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@yourdomain.com
SMTP_PASS=your_smtp_password_here
CONTACT_EMAIL=support@greyiqsolutions.com

