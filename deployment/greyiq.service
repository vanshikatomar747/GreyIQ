# Systemd service unit template for GreyIQ Node.js backend
# Save this file to /etc/systemd/system/greyiq.service
# Control service with: systemctl start/stop/status/restart/enable greyiq

[Unit]
Description=GreyIQ MERN Backend Service
After=network.target mongodb.service

[Service]
Type=simple
User=root
# Set directory to where the backend server.js resides on the VPS
WorkingDirectory=/var/www/greyiq/server
# Command to launch the backend server
ExecStart=/usr/bin/node server.js
# Load environment variables from the .env configuration file
EnvironmentFile=/var/www/greyiq/server/.env
# Automatic restart settings
Restart=always
RestartSec=10
# Standard output logging
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=greyiq-backend

[Install]
WantedBy=multi-user.target
