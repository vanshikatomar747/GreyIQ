# Base URL for the backend API.
# - If you are using Nginx reverse proxy to route `/api` requests to the node server (recommended), leave this as `/api`.
# - If your frontend and backend are hosted on different domains, set this to the full URL of the backend (e.g. `https://api.yourcustomdomain.com/api`).
VITE_API_URL=https://greyiq.onrender.com/api
